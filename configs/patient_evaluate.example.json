{
  "description": "Evaluate a complete TACA-MIL state_dict checkpoint with explicit cohort and cell-cap settings.",
  "module": "patient_level.taca_mil.eval",
  "arguments": [
    "--split_xlsx", "${FCM_DATA_ROOT}/patient_split.xlsx",
    "--sheet", "test",
    "--checkpoint", "${FCM_PATIENT_CHECKPOINT}",
    "--output_dir", "${FCM_OUTPUT_ROOT}/patient_evaluation",
    "--filter_mode", "none",
    "--max_cells_per_tube", "5000",
    "--seed", "42"
  ]
}
